# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_APP_NAME=VOTEI

# Price per generation, in cents. Defaults to 290 (R$ 2,90) when unset.
# Accepted range: 100–10000. Changing this needs no code change.
PRICE_BRL_CENTS=290

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Anonymous sign-in MUST be enabled: Authentication → Providers → Anonymous.
# The app has no sign-up; the anonymous session is the buyer's only key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── EFI Bank (Pix) ───────────────────────────────────────────────────────────
# Production: https://pix.api.efipay.com.br
# Sandbox:    https://pix-h.api.efipay.com.br
EFI_PIX_BASE_URL=https://pix.api.efipay.com.br
EFI_CLIENT_ID=Client_Id_...
EFI_CLIENT_SECRET=Client_Secret_...

# The Pix key that receives the money (CPF/CNPJ, e-mail, phone or random key).
EFI_PIX_KEY=sua-chave-pix

# EFI's Pix API requires mutual TLS. Export the .p12 they issue, then:
#   base64 -w0 certificado.p12
EFI_CERT_PFX_BASE64=
EFI_CERT_PASSPHRASE=

# Alternative to the .p12: a single PEM holding both certificate and key.
#   base64 -w0 certificado.pem
# EFI_CERT_PEM_BASE64=

# ─── Local development without a certificate ──────────────────────────────────
# Charges settle on a timer so the whole flow is testable before EFI is wired.
# Ignored when NODE_ENV=production.
EFI_FAKE_PIX=true
EFI_FAKE_SETTLE_SECONDS=8

# ─── Maintenance ──────────────────────────────────────────────────────────────
# Bearer token for POST /api/v1/maintenance/purge. Vercel Cron sends it
# automatically when the variable is named CRON_SECRET.
CRON_SECRET=generate-a-long-random-string

# ─── Rate limiting (optional; no-ops when unset) ──────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
